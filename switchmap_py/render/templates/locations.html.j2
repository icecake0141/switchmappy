<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <title>Locations - SwitchMappy</title>
  <link rel="stylesheet" href="/switchmap.css" />
</head>
<body>
  {% from "navigation.html.j2" import report_nav %}
  <header>
    <h1>Locations</h1>
    <p>Generated at {{ build_date.isoformat() }}</p>
  </header>
  {{ report_nav('locations') }}
  <div class="filter-row">
    <input id="locationFilter" type="text" placeholder="Filter by office, location, switch, port, hostname" />
  </div>
  <div class="table-scroll">
  <table>
    <thead>
      <tr>
        <th>Office</th>
        <th>Location</th>
        <th>Endpoints</th>
        <th>Switches</th>
        <th>Ports</th>
        <th>Hostnames</th>
      </tr>
    </thead>
    <tbody>
      {% for location in locations %}
      <tr data-filter="{{ [location.office, location.location, location.switches | join(' '), location.ports | join(' '), location.hostnames | join(' ')] | join(' ') | lower }}">
        <td>{{ location.office or '' }}</td>
        <td>{{ location.location or '' }}</td>
        <td>{{ location.endpoints }}</td>
        <td>{{ location.switches | join(', ') }}</td>
        <td>{{ location.ports | join(', ') }}</td>
        <td>{{ location.hostnames | join(', ') }}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
  </div>
  <script>
    const locationFilter = document.getElementById('locationFilter');
    function applyLocationFilter() {
      const query = locationFilter.value.toLowerCase().trim();
      for (const row of document.querySelectorAll('tbody tr[data-filter]')) {
        row.style.display = !query || row.dataset.filter.includes(query) ? '' : 'none';
      }
    }
    locationFilter.addEventListener('input', applyLocationFilter);
  </script>
</body>
</html>
